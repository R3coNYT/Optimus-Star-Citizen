<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      InvariantGlobalization est volontairement DESACTIVE.

      L'avoir active a introduit un bug silencieux et grave : sans ICU, string.Normalize(FormD)
      ne decompose plus rien, « lumieres » devenait « lumi res », et le matcher resolvait
      « allume les lumieres » vers ship.weapons.toggle - une commande que personne n'avait
      demandee. La resolution de culture fr-FR du moteur de reconnaissance en aurait souffert
      de la meme facon.

      Une application qui ecoute et parle francais est culture-dependante par nature. Le gain
      de quelques megaoctets ne vaut pas ce risque.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      Un avertissement ignoré est une régression en attente. Le moteur pilote un clavier :
      on ne se paie pas le luxe de laisser passer une référence potentiellement nulle.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <NeutralLanguage>en-US</NeutralLanguage>
    <Company>Optimus</Company>
    <Product>Optimus</Product>
    <Version>0.1.3</Version>
  </PropertyGroup>

</Project>
