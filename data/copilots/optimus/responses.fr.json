        { "text": "{command} échoue systématiquement. Vérifiez sa configuration." },
        { "text": "Toujours aucune touche assignée." },
        { "text": "Même cause, {pilote}. Touche manquante." },
        { "text": "Rien n'a changé. Raccourci absent." }
      ]
    },
