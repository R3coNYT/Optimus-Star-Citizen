<Window x:Class="Optimus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bind="clr-namespace:Optimus.Core.Bindings;assembly=Optimus.Core"
        Title="Optimus" Height="760" Width="1180" MinHeight="560" MinWidth="960"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================== Bandeau d'état ============================== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="OPTIMUS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
            <Run Text="{Binding CopilotName, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding VoiceName, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <StackPanel Margin="18,0">
            <TextBlock Text="STAR CITIZEN" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding GameLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameReady}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="MODE" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding ModeLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReal}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="VOL" Style="{StaticResource Label}" />
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="navigation" />
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CombatActive}" Value="True">
                      <Setter Property="Text" Value="COMBAT" />
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <!-- L'arret d'urgence reste visible en permanence (§37) : le chercher dans un
             onglet quand une touche part en boucle serait absurde. -->
        <Button Grid.Column="2" Command="{Binding ToggleKillSwitchCommand}"
                Content="{Binding KillSwitchLabel}" FontWeight="Bold" Padding="18,10">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Foreground" Value="{StaticResource Danger}" />
              <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding KillSwitch}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Danger}" />
                  <Setter Property="Foreground" Value="#12151A" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

      <!-- ========================= Poste de pilotage ========================= -->
      <TabItem Header="Poste de pilotage">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <Button Command="{Binding ToggleListeningCommand}" Content="{Binding ListeningLabel}"
                    Padding="18,12" FontSize="14" FontWeight="SemiBold" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11">
              <Run Text="Dites «&#160;" /><Run Text="{Binding WakeWord, Mode=OneWay}" /><Run Text=",&#160;…&#160;» pour être entendu." />
            </TextBlock>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="ENVOI DE TOUCHES" Style="{StaticResource Label}" />
            <Button Command="{Binding ToggleSimulationCommand}" Content="{Binding ModeLabel}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="En simulation, rien n'est envoyé au jeu : la séquence est tracée telle qu'elle aurait été jouée." />

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="ESSAYER UN ÉNONCÉ" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Utterance, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnUtteranceKeyDown" />
            <Button Command="{Binding SendCommand}" Content="Envoyer" Margin="0,8,0,0" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="Passe par la même chaîne que la voix, sans le micro. Utile pour vérifier une formulation." />
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,10">
                <TextBlock Text="JOURNAL" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Command="{Binding OpenLogsCommand}" Content="Journaux sur disque"
                          Padding="10,4" FontSize="11"
                          ToolTip="Ouvre le dossier contenant les journaux et les rapports de plantage." />
                  <Button Command="{Binding ClearJournalCommand}" Content="Effacer"
                          Padding="10,4" FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
              </Grid>

              <ListView Grid.Row="1" x:Name="JournalList" ItemsSource="{Binding Journal}"
                        BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                 FontSize="11" Foreground="{StaticResource TextMuted}"
                                 VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource JournalTitle}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============================= Commandes ============================= -->
      <TabItem Header="Commandes">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding CatalogSummary}" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />
            <Button Command="{Binding TestCommandCommand}" Content="Tester la commande choisie"
                    HorizontalAlignment="Right" />
          </Grid>

          <ListView Grid.Row="1" ItemsSource="{Binding Commands}"
                    SelectedItem="{Binding SelectedCommand}"
                    ItemContainerStyle="{StaticResource GridRow}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="CATÉGORIE" Width="110" DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Header="COMMANDE" Width="210" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="TOUCHE" Width="190">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Binding}" FontFamily="Consolas">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsBinding}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="FORMULATIONS" Width="520" DisplayMemberBinding="{Binding Phrases}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <!-- ============================== Touches ============================== -->
      <TabItem Header="Touches">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="PROFIL DE TOUCHES" Style="{StaticResource Label}" />

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding ActiveProfile}" />

                <TextBox Grid.Column="1" Margin="10,0,0,0"
                         Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Nom du profil a creer, dupliquer ou renommer" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                  <Button Command="{Binding CreateProfileCommand}" Content="Creer" />
                  <Button Command="{Binding DuplicateProfileCommand}" Content="Dupliquer" Margin="6,0,0,0" />
                  <Button Command="{Binding RenameProfileCommand}" Content="Renommer" Margin="6,0,0,0" />
                  <Border Width="1" Background="{StaticResource Line}" Margin="12,2" />
                  <Button Command="{Binding DeleteProfileCommand}" Content="Supprimer" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding ProfileHint}" Style="{StaticResource Hint}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding BindingFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Cherchez par libellé ou par ce que vous dites : « lumieres », « portes »…" />
            <TextBlock Grid.Column="1" Text="{Binding BindingSummary}" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          </Grid>

          <ListView Grid.Row="2" ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedSlot}"
                    ItemContainerStyle="{StaticResource GridRow}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="ÉTAT" Width="120">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="à configurer" />
                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBound}" Value="True">
                                <Setter Property="Text" Value="liée" />
                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsBound}" Value="False" />
                                  <Condition Binding="{Binding Need}"
                                             Value="{x:Static bind:ActionNeed.Directed}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="facultative" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="COMMANDE" Width="210" DisplayMemberBinding="{Binding CommandName}" />
                <GridViewColumn Header="TOUCHE" Width="180">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Input}" FontFamily="Consolas" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ACTION DU JEU" Width="380" DisplayMemberBinding="{Binding ActionId}" />
                <GridViewColumn Header="ORIGINE" Width="110" DisplayMemberBinding="{Binding Origin}" />
              </GridView>
            </ListView.View>
          </ListView>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding AssignCommand}" Content="Assigner une touche" />
            <Button Command="{Binding UnassignCommand}" Content="Retirer" Margin="8,0,0,0" />
            <Border Width="1" Background="{StaticResource Line}" Margin="14,2" />
            <Button Command="{Binding ImportLayoutCommand}" Content="Importer depuis le jeu" />
            <Button Command="{Binding ExportLayoutCommand}" Content="Exporter vers le jeu" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="Assigner ici ne suffit pas : le jeu n'obéit qu'à ses propres bindings. Exportez, puis « pp_RebindKeys optimus »." />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================= Réglages ============================= -->
      <TabItem Header="Réglages" DataContext="{Binding Settings}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="ÉCOUTE" Style="{StaticResource Label}" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding AlwaysOn}"
                                 Content="Écoute permanente, déclenchée par le mot d'éveil" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding PushToTalk}"
                                 Content="Push-to-talk : une touche maintenue" />
                    <TextBlock Text="{Binding ModeExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,14,0,0" IsEnabled="{Binding PushToTalk}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding PushToTalkKey}" IsReadOnly="True"
                               FontFamily="Consolas" VerticalContentAlignment="Center" />
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="Presser une touche"
                              Command="{Binding CaptureKeyCommand}" />
                    </Grid>
                    <CheckBox IsChecked="{Binding RequireWakeWordInPushToTalk}"
                              IsEnabled="{Binding PushToTalk}"
                              Content="Exiger quand même le mot d'éveil" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="MOT D'ÉVEIL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding WakeWord, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Le changer reconstruit toute la grammaire. Choisissez un mot que vous ne prononcez pas par hasard en vol." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="SEUILS DE RECONNAISSANCE" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Plancher de bruit :" />
                      <Run Text="{Binding NoiseFloor, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding NoiseFloor}" Minimum="0" Maximum="0.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Exécution à partir de :" />
                      <Run Text="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding ConfidenceThreshold}" Minimum="0.3" Maximum="0.95" TickFrequency="0.01" />

                    <TextBlock Text="{Binding ThresholdExplanation}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="VOIX" Style="{StaticResource Label}" />

                    <CheckBox IsChecked="{Binding NeuralVoice}"
                              IsEnabled="{Binding NeuralVoiceAvailable}"
                              Content="Voix neuronale locale (Piper)" />
                    <TextBlock Text="{Binding VoiceEngineExplanation}" Style="{StaticResource Hint}" />

                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding VoiceId}"
                              Margin="0,10,0,0" />

                    <TextBlock Margin="0,10,0,0" FontSize="12">
                      <Run Text="Débit :" />
                      <Run Text="{Binding Rate, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Rate}" Minimum="0.5" Maximum="1.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Volume :" />
                      <Run Text="{Binding Volume, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Volume}" Minimum="0.1" Maximum="1.0" TickFrequency="0.01" />

                    <Button Content="Écouter un essai" Command="{Binding TestVoiceCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="L'essai emploie les réglages affichés, pas ceux enregistrés : vous entendez avant de valider." />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="ÉTAGE CONVERSATIONNEL" Style="{StaticResource Label}" />
                    <CheckBox IsChecked="{Binding AiEnabled}"
                              Content="Faire appel à un modèle quand rien n'est compris" />
                    <TextBlock Text="{Binding AiExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,12,0,0" IsEnabled="{Binding AiEnabled}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Fournisseur"
                                 Style="{StaticResource Hint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding AiProvider}"
                                SelectedValuePath="Content">
                        <ComboBoxItem Content="ollama" />
                        <ComboBoxItem Content="openai" />
                      </ComboBox>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Adresse"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Modèle"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Appels max"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiBudget, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Button Content="Vérifier la connexion" Command="{Binding ProbeAiCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding AiProbe}" Style="{StaticResource Hint}"
                               Foreground="{StaticResource Warn}" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="CARACTÈRE" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Formalité" /><Run Text="  " /><Run Text="{Binding Formality}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Formality}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Humour" /><Run Text="  " /><Run Text="{Binding Humor}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Humor}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Ironie" /><Run Text="  " /><Run Text="{Binding Sarcasm}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Sarcasm}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Chaleur" /><Run Text="  " /><Run Text="{Binding Warmth}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Warmth}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Calme" /><Run Text="  " /><Run Text="{Binding Calmness}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Calmness}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Verbosité" /><Run Text="  " /><Run Text="{Binding Verbosity}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Verbosity}" Minimum="0" Maximum="100" TickFrequency="1" />
                    <TextBlock Text="{Binding VerbosityEffect}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="CE QUE ÇA DONNE" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Preview}" FontStyle="Italic" LineHeight="22"
                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Trois répliques tirées du vrai catalogue, composées avec les curseurs ci-contre. Une variante ironique n'apparaît qu'au-dessus d'un certain seuil." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding SaveCommand}" Content="Enregistrer" Padding="20,8" FontWeight="SemiBold" />
            <Button Command="{Binding RevertCommand}" Content="Annuler les modifications" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource Warn}" Text="Modifications non enregistrées">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================== Macros ============================== -->
      <TabItem Header="Macros" DataContext="{Binding MacroEditor}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- ============================== liste ============================== -->
          <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Macros}" SelectedItem="{Binding Selected}"
                     Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                     Foreground="{StaticResource Text}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="10,7" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                      <Run Text="{Binding Origin, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Command="{Binding NewCommand}" Content="Nouvelle" />
              <Button Command="{Binding DuplicateCommand}" Content="Dupliquer" Margin="6,0,0,0" />
              <Button Command="{Binding DeleteCommand}" Content="Supprimer" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>

          <!-- ============================= éditeur ============================= -->
          <Grid Grid.Column="1" IsEnabled="{Binding CanEdit}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="NOM" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="Ce qu'Optimus prononce quand il en parle." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="FORMULATIONS — UNE PAR LIGNE" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Phrases, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True" MinHeight="72" VerticalScrollBarVisibility="Auto"
                           TextWrapping="NoWrap" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="Écrivez-les accentuées : le moteur en déduit la prononciation." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="TEMPORISATION" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding CooldownMs, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="En millisecondes. Empêche de la relancer pendant qu'elle se déroule." />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
              </Grid.ColumnDefinitions>

              <ListBox Grid.Column="0" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                       Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                       Foreground="{StaticResource Text}" FontFamily="Consolas">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,5" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas" TextWrapping="Wrap"
                               Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <!-- Les valeurs par defaut sont indispensables : sans elles, la fin du
                               declencheur rend UnsetValue, que Foreground refuse - et l'exception
                               remonte jusqu'a la fenetre. -->
                          <Setter Property="Foreground" Value="{StaticResource Text}" />
                          <Setter Property="FontStyle" Value="Normal" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarker}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                              <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"
                      DataContext="{Binding SelectedStep}">
                <StackPanel>
                  <TextBlock Text="ÉTAPE CHOISIE" Style="{StaticResource Label}" />

                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                             Text="Choisissez une étape dans la séquence pour la modifier.">
                    <TextBlock.Visibility>
                      <Binding Path="." Converter="{StaticResource NullToVisible}"
                               FallbackValue="Visible" TargetNullValue="Visible" />
                    </TextBlock.Visibility>
                  </TextBlock>

                  <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="Commande" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <ComboBox ItemsSource="{Binding DataContext.Callable,
                                            RelativeSource={RelativeSource AncestorType=TabItem}}"
                              SelectedItem="{Binding CommandId}" />

                    <TextBlock Text="Sens" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                    <ComboBox SelectedIndex="{Binding Polarity, Converter={StaticResource PolarityToIndex}}">
                      <ComboBoxItem Content="basculer" />
                      <ComboBoxItem Content="allumer" />
                      <ComboBoxItem Content="éteindre" />
                    </ComboBox>

                    <CheckBox IsChecked="{Binding RequireDirected}"
                              Content="Exiger un sens garanti" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Renonce à l'étape plutôt que de basculer à l'aveugle. À cocher quand l'état de départ est incertain — les portes, par exemple." />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="Ce qui est interrogé" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <ComboBox SelectedIndex="{Binding Subject, Converter={StaticResource SubjectToIndex}}">
                      <ComboBoxItem Content="la commande a toutes ses touches" />
                      <ComboBoxItem Content="le sens est garanti par le jeu" />
                      <ComboBoxItem Content="Optimus simule" />
                      <ComboBoxItem Content="le mode de vol" />
                      <ComboBoxItem Content="l'état supposé d'une bascule" />
                    </ComboBox>
                    <TextBlock Text="{Binding SubjectCaveat}" Style="{StaticResource Hint}" />

                    <StackPanel Visibility="{Binding ConditionNeedsCommand, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="Commande visée" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox ItemsSource="{Binding DataContext.Callable,
                                              RelativeSource={RelativeSource AncestorType=TabItem}}"
                                SelectedItem="{Binding ConditionCommandId}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ConditionNeedsPolarity, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="Sens" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox SelectedIndex="{Binding ConditionPolarity, Converter={StaticResource PolarityToIndex}}">
                        <ComboBoxItem Content="basculer" IsEnabled="False" />
                        <ComboBoxItem Content="allumer" />
                        <ComboBoxItem Content="éteindre" />
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ConditionNeedsValue, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="Valeur attendue" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox ItemsSource="{Binding ConditionValues}" SelectedItem="{Binding ConditionValue}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding ConditionNegated}" Content="Inverser la condition" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Les étapes suivantes indentées forment le « alors ». Celles placées sous « sinon » ne se jouent que si la condition ne tient pas." />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsLoop, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="Nombre de tours" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Un compte fixe, entre 1 et 20. Une boucle « tant que » ne pourrait pas être planifiée à l'avance, et le garde ne pourrait plus vérifier la séquence complète avant qu'une touche ne parte." />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsWait, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="Attente (ms)" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding WaitMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Le jeu ne répond pas à deux touches envoyées dans la même milliseconde." />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsSay, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="Clé de réplique" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding ResponseKey, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Une entrée de responses.fr.json. Optimus se tait si elle n'existe pas." />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Command="{Binding AddCommandStepCommand}" Content="+ Commande" />
              <Button Command="{Binding AddWaitStepCommand}" Content="+ Attente" Margin="6,0,0,0" />
              <Button Command="{Binding AddSayStepCommand}" Content="+ Parole" Margin="6,0,0,0" />
              <Button Command="{Binding AddBranchStepCommand}" Content="+ Si" Margin="6,0,0,0" />
              <Button Command="{Binding AddLoopStepCommand}" Content="+ Répéter" Margin="6,0,0,0" />
              <Border Width="1" Background="{StaticResource Line}" Margin="12,2" />
              <Button Command="{Binding MoveUpCommand}" Content="Monter" />
              <Button Command="{Binding MoveDownCommand}" Content="Descendre" Margin="6,0,0,0" />
              <Button Command="{Binding RemoveStepCommand}" Content="Retirer" Margin="6,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Content="Enregistrer" Padding="20,8"
                        FontWeight="SemiBold" />
                <Button Command="{Binding RevertCommand}" Content="Annuler" Margin="6,0,0,0" />
                <Button Command="{Binding TestCommand}" Content="Essayer en simulation"
                        Margin="6,0,0,0" />
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding Verdict}" Margin="16,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource Warn}" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- =========================== Compréhension =========================== -->
      <TabItem Header="Compréhension" DataContext="{Binding Understanding}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="La grammaire est fermée : Optimus ne peut restituer qu'une formulation qu'il connaît déjà. Cette liste dit sur quelle commande il a hésité, pas ce que vous avez dit — c'est à vous d'écrire la tournure que vous employez." />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
              </Grid.RowDefinitions>

              <ListView Grid.Row="0" ItemsSource="{Binding Hesitations}"
                        SelectedItem="{Binding Selected}"
                        ItemContainerStyle="{StaticResource GridRow}">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="ENTENDU" Width="190" DisplayMemberBinding="{Binding Heard}" />
                    <GridViewColumn Header="CE QU'IL EN A FAIT" Width="160" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="COMMANDE ENVISAGÉE" Width="170" DisplayMemberBinding="{Binding CommandName}" />
                    <GridViewColumn Header="FRÉQUENCE" Width="230" DisplayMemberBinding="{Binding Detail}" />
                  </GridView>
                </ListView.View>
              </ListView>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Command="{Binding IgnoreCommand}" Content="Ignorer cette ligne" />
                <Button Command="{Binding ClearCommand}" Content="Vider la liste" Margin="6,0,0,0" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="VOS FORMULATIONS" Style="{StaticResource Label}"
                         Margin="0,16,0,4" />

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" ItemsSource="{Binding Aliases}"
                          SelectedItem="{Binding SelectedAlias}"
                          ItemContainerStyle="{StaticResource GridRow}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="FORMULATION" Width="260" DisplayMemberBinding="{Binding Phrase}" />
                      <GridViewColumn Header="COMMANDE" Width="230" DisplayMemberBinding="{Binding CommandName}" />
                      <GridViewColumn Header="SENS" Width="120" DisplayMemberBinding="{Binding Sense}" />
                    </GridView>
                  </ListView.View>
                </ListView>

                <Button Grid.Column="1" Command="{Binding RemoveAliasCommand}" Content="Retirer"
                        Margin="8,0,0,0" VerticalAlignment="Top" />
              </Grid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"
                    VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="APPRENDRE UNE FORMULATION" Style="{StaticResource Label}" />

                <TextBlock Text="Ce que vous dites réellement" Style="{StaticResource Hint}"
                           Margin="0,8,0,2" />
                <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Écrivez-la accentuée : le moteur en déduit la prononciation." />

                <TextBlock Text="Commande à déclencher" Style="{StaticResource Hint}"
                           Margin="0,12,0,2" />
                <ComboBox ItemsSource="{Binding Commands}" SelectedItem="{Binding TargetCommand}" />

                <TextBlock Text="Sens" Style="{StaticResource Hint}" Margin="0,12,0,2" />
                <ComboBox SelectedIndex="{Binding Polarity, Converter={StaticResource PolarityToIndex}}">
                  <ComboBoxItem Content="aucun — bascule" />
                  <ComboBoxItem Content="activation" />
                  <ComboBoxItem Content="extinction" />
                </ComboBox>

                <Button Command="{Binding AddCommand}" Content="Apprendre" Margin="0,16,0,0"
                        Padding="20,8" FontWeight="SemiBold" HorizontalAlignment="Left" />

                <TextBlock Text="{Binding Verdict}" Style="{StaticResource Hint}"
                           Foreground="{StaticResource Warn}" Margin="0,10,0,0" />

                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="La formulation est enregistrée hors du catalogue livré : elle survit aux mises à jour d'Optimus." />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
