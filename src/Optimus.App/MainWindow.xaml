<Window x:Class="Optimus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bind="clr-namespace:Optimus.Core.Bindings;assembly=Optimus.Core"
        Title="Optimus" Height="760" Width="1180" MinHeight="560" MinWidth="960"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Face}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================== Bandeau d'état ============================== -->
    <ContentControl Grid.Row="0" Style="{StaticResource Card}"
                    Padding="18,13" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource App.OPTIMUS}" FontSize="21" FontWeight="Bold"
                     Foreground="{StaticResource Accent}" Effect="{StaticResource Glow}" />
          <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
            <Run Text="{Binding CopilotName, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding VoiceName, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <StackPanel Margin="18,0">
            <TextBlock Text="{DynamicResource App.STARCITIZEN}" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding GameLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameReady}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="{DynamicResource App.MODE}" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding ModeLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReal}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="{DynamicResource App.VOL}" Style="{StaticResource Label}" />
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{DynamicResource App.Navigation}" />
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CombatActive}" Value="True">
                      <Setter Property="Text" Value="{DynamicResource App.COMBAT}" />
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <!-- L'arret d'urgence reste visible en permanence (§37) : le chercher dans un
             onglet quand une touche part en boucle serait absurde. -->
        <Button Grid.Column="2" Command="{Binding ToggleKillSwitchCommand}"
                Content="{Binding KillSwitchLabel}" FontWeight="Bold" Padding="18,10">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Foreground" Value="{StaticResource Danger}" />
              <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding KillSwitch}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Danger}" />
                  <Setter Property="Foreground" Value="#05090E" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </ContentControl>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

      <!-- ========================= Poste de pilotage ========================= -->
      <TabItem Header="{DynamicResource Cockpit.PostePilotage}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <Button Command="{Binding ToggleListeningCommand}" Content="{Binding ListeningLabel}"
                    Padding="18,12" FontSize="14" FontWeight="SemiBold" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11">
              <Run Text="Dites «&#160;" /><Run Text="{Binding WakeWord, Mode=OneWay}" /><Run Text=",&#160;…&#160;» pour être entendu." />
            </TextBlock>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="{DynamicResource Cockpit.ENVOITOUCHES}" Style="{StaticResource Label}" />
            <Button Command="{Binding ToggleSimulationCommand}" Content="{Binding ModeLabel}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="{DynamicResource Cockpit.SimulationRienNEnvoye}" />

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="{DynamicResource Cockpit.ESSAYERENONCE}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Utterance, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnUtteranceKeyDown" />
            <Button Command="{Binding SendCommand}" Content="{DynamicResource Cockpit.Envoyer}" Margin="0,8,0,0" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="{DynamicResource Cockpit.PasseMemeChaineVoix}" />
          </StackPanel>

          <ContentControl Grid.Column="1" Style="{StaticResource Card}"
                          Padding="0" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,10">
                <TextBlock Text="{DynamicResource Cockpit.JOURNAL}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Command="{Binding OpenLogsCommand}" Content="{DynamicResource Cockpit.JournauxDisque}"
                          Padding="10,4" FontSize="11"
                          ToolTip="{DynamicResource Cockpit.OuvreDossierContenantJournaux}" />
                  <Button Command="{Binding ClearJournalCommand}" Content="{DynamicResource Cockpit.Effacer}"
                          Padding="10,4" FontSize="11" Margin="6,0,0,0" />
                </StackPanel>
              </Grid>

              <ListView Grid.Row="1" x:Name="JournalList" ItemsSource="{Binding Journal}"
                        BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainRow}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                 FontSize="11" Foreground="{StaticResource TextMuted}"
                                 VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource JournalTitle}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </ContentControl>
        </Grid>
      </TabItem>

      <!-- ============================= Commandes ============================= -->
      <TabItem Header="{DynamicResource Commands.Commandes}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding CatalogSummary}" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />
            <Button Command="{Binding TestCommandCommand}" Content="{DynamicResource Commands.TesterCommandeChoisie}"
                    HorizontalAlignment="Right" />
          </Grid>

          <ListView Grid.Row="1" ItemsSource="{Binding Commands}"
                    SelectedItem="{Binding SelectedCommand}"
                    ItemContainerStyle="{StaticResource GridRow}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{DynamicResource Commands.CATEGORIE}" Width="110" DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Header="{DynamicResource Commands.COMMANDE}" Width="210" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="{DynamicResource Commands.TOUCHE}" Width="190">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Binding}" FontFamily="Consolas">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsBinding}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource Commands.FORMULATIONS}" Width="520" DisplayMemberBinding="{Binding Phrases}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <!-- ============================== Touches ============================== -->
      <TabItem Header="{DynamicResource Keys.Touches}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ContentControl Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{DynamicResource Keys.PROFILTOUCHES}" Style="{StaticResource Label}" />

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding ActiveProfile}" />

                <TextBox Grid.Column="1" Margin="10,0,0,0"
                         Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource Keys.NomProfilCreerDupliquer}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                  <Button Command="{Binding CreateProfileCommand}" Content="{DynamicResource Keys.Creer}" />
                  <Button Command="{Binding DuplicateProfileCommand}" Content="{DynamicResource Keys.Dupliquer}" Margin="6,0,0,0" />
                  <Button Command="{Binding RenameProfileCommand}" Content="{DynamicResource Keys.Renommer}" Margin="6,0,0,0" />
                  <Border Width="1" Background="{StaticResource Line}" Margin="12,2" />
                  <Button Command="{Binding DeleteProfileCommand}" Content="{DynamicResource Keys.Supprimer}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding ProfileHint}" Style="{StaticResource Hint}" />
            </StackPanel>
          </ContentControl>

          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding BindingFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Keys.CherchezLibelleVousDites}" />
            <TextBlock Grid.Column="1" Text="{Binding BindingSummary}" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          </Grid>

          <ListView Grid.Row="2" ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedSlot}"
                    ItemContainerStyle="{StaticResource GridRow}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{DynamicResource Keys.ETAT}" Width="120">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource Keys.Configurer}" />
                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBound}" Value="True">
                                <Setter Property="Text" Value="{DynamicResource Keys.Liee}" />
                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsBound}" Value="False" />
                                  <Condition Binding="{Binding Need}"
                                             Value="{x:Static bind:ActionNeed.Directed}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="{DynamicResource Keys.Facultative}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource Commands.COMMANDE}" Width="210" DisplayMemberBinding="{Binding CommandName}" />
                <GridViewColumn Header="{DynamicResource Commands.TOUCHE}" Width="180">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Input}" FontFamily="Consolas" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{DynamicResource Keys.ACTIONJEU}" Width="380" DisplayMemberBinding="{Binding ActionId}" />
                <GridViewColumn Header="{DynamicResource Keys.ORIGINE}" Width="110" DisplayMemberBinding="{Binding Origin}" />
              </GridView>
            </ListView.View>
          </ListView>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding AssignCommand}" Content="{DynamicResource Keys.AssignerTouche}" />
            <Button Command="{Binding UnassignCommand}" Content="{DynamicResource Keys.Retirer}" Margin="8,0,0,0" />
            <Border Width="1" Background="{StaticResource Line}" Margin="14,2" />
            <Button Command="{Binding ImportLayoutCommand}" Content="{DynamicResource Keys.ImporterDepuisJeu}" />
            <Button Command="{Binding ExportLayoutCommand}" Content="{DynamicResource Keys.ExporterVersJeu}" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="{DynamicResource Keys.AssignerIciSuffitJeu}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================= Réglages ============================= -->
      <TabItem Header="{DynamicResource Settings.Reglages}" DataContext="{Binding Settings}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.LANGUELANGUAGE}" Style="{StaticResource Label}" />

                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding ActiveLanguage}" />

                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Settings.ChangementPrendEffetAussitot}" />

                    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Warn}"
                               Text="{Binding LanguageWarning}"
                               Visibility="{Binding HasLanguageWarning, Converter={StaticResource BoolToVisible}}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.COPILOTE}" Style="{StaticResource Label}" />

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <ComboBox Grid.Column="0" ItemsSource="{Binding Copilots}"
                                SelectedItem="{Binding ActiveCopilot}" />

                      <Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource Keys.Supprimer}"
                              Command="{Binding DeleteCopilotCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding CopilotHint}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBox Grid.Column="0"
                               Text="{Binding CopilotName, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{DynamicResource Settings.NomCopiloteCreer}" />

                      <Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource Keys.Dupliquer}"
                              Command="{Binding DuplicateCopilotCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Settings.ChangementPrendEffetAussitot2}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.ECOUTE}" Style="{StaticResource Label}" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding AlwaysOn}"
                                 Content="{DynamicResource Settings.EcoutePermanenteDeclencheeMot}" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding PushToTalk}"
                                 Content="{DynamicResource Settings.PushToTalkTouche}" />
                    <TextBlock Text="{Binding ModeExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,14,0,0" IsEnabled="{Binding PushToTalk}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding PushToTalkKey}" IsReadOnly="True"
                               FontFamily="Consolas" VerticalContentAlignment="Center" />
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource Settings.PresserTouche}"
                              Command="{Binding CaptureKeyCommand}" />
                    </Grid>
                    <CheckBox IsChecked="{Binding RequireWakeWordInPushToTalk}"
                              IsEnabled="{Binding PushToTalk}"
                              Content="{DynamicResource Settings.ExigerQuandMemeMot}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.MOTDEVEIL}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding WakeWord, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Settings.ChangerReconstruitTouteGrammaire}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.SEUILSRECONNAISSANCE}" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.PlancherBruit}" />
                      <Run Text="{Binding NoiseFloor, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding NoiseFloor}" Minimum="0" Maximum="0.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.ExecutionPartir}" />
                      <Run Text="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding ConfidenceThreshold}" Minimum="0.3" Maximum="0.95" TickFrequency="0.01" />

                    <TextBlock Text="{Binding ThresholdExplanation}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.VOIX}" Style="{StaticResource Label}" />

                    <CheckBox IsChecked="{Binding NeuralVoice}"
                              IsEnabled="{Binding NeuralVoiceAvailable}"
                              Content="{DynamicResource Settings.VoixNeuronaleLocalePiper}" />
                    <TextBlock Text="{Binding VoiceEngineExplanation}" Style="{StaticResource Hint}" />

                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding VoiceId}"
                              Margin="0,10,0,0" />

                    <TextBlock Margin="0,10,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Debit}" />
                      <Run Text="{Binding Rate, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Rate}" Minimum="0.5" Maximum="1.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Volume}" />
                      <Run Text="{Binding Volume, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Volume}" Minimum="0.1" Maximum="1.0" TickFrequency="0.01" />

                    <Button Content="{DynamicResource Settings.EcouterEssai}" Command="{Binding TestVoiceCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Settings.LEssaiEmploieReglages}" />
                  </StackPanel>
                </ContentControl>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.APILOCALE}" Style="{StaticResource Label}" />
                    <CheckBox IsChecked="{Binding ApiEnabled}"
                              Content="{DynamicResource Settings.OuvrirLInterfaceLocale}" />
                    <TextBlock Text="{Binding ApiExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,12,0,0" IsEnabled="{Binding ApiEnabled}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.Port}"
                                 Style="{StaticResource Hint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="0" Grid.Column="1"
                               Text="{Binding ApiPort, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.ExecutionsMin}"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding ApiRate, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.Jeton}"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsReadOnly="True"
                               FontFamily="Consolas" Text="{Binding ApiTokenSecret, Mode=OneWay}" />
                    </Grid>

                    <Button Content="{DynamicResource Settings.RegenererJeton}" Command="{Binding RegenerateTokenCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ApiState}" Style="{StaticResource Hint}"
                               Foreground="{StaticResource Accent}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.PAROLELIBREWHISPER}" Style="{StaticResource Label}" />

                    <StackPanel IsEnabled="{Binding WhisperAvailable}">
                      <RadioButton GroupName="Whisper" IsChecked="{Binding WhisperOff}"
                                   Content="{DynamicResource Settings.EteintGrammaireFermeeSeulement}" />
                      <RadioButton GroupName="Whisper" IsChecked="{Binding WhisperOnRejects}"
                                   Content="{DynamicResource Settings.QuandMoteurRapideDoute}" />
                      <RadioButton GroupName="Whisper" IsChecked="{Binding WhisperOnEverything}"
                                   Content="{DynamicResource Settings.ToutCommandesComprisesPlus}" />

                      <CheckBox IsChecked="{Binding WhisperTrimContext}" Margin="0,8,0,0"
                                Content="{DynamicResource Settings.FenetreReduitePlusRapide}" />
                    </StackPanel>

                    <TextBlock Text="{Binding WhisperExplanation}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.ETAGECONVERSATIONNEL}" Style="{StaticResource Label}" />
                    <CheckBox IsChecked="{Binding AiEnabled}"
                              Content="{DynamicResource Settings.FaireAppelModeleQuand}" />
                    <TextBlock Text="{Binding AiExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,12,0,0" IsEnabled="{Binding AiEnabled}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.Fournisseur}"
                                 Style="{StaticResource Hint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding AiProvider}"
                                SelectedValuePath="Content">
                        <ComboBoxItem Content="{DynamicResource Settings.Ollama}" />
                        <ComboBoxItem Content="{DynamicResource Settings.Openai}" />
                      </ComboBox>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.Adresse}"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.Modele}"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings.AppelsMax}"
                                 Style="{StaticResource Hint}" Margin="0,10,8,0" VerticalAlignment="Center" />
                      <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                               Text="{Binding AiBudget, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Button Content="{DynamicResource Settings.VerifierConnexion}" Command="{Binding ProbeAiCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding AiProbe}" Style="{StaticResource Hint}"
                               Foreground="{StaticResource Warn}" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.CARACTERE}" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Formalite}" /><Run Text="  " /><Run Text="{Binding Formality}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Formality}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Humour}" /><Run Text="  " /><Run Text="{Binding Humor}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Humor}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Ironie}" /><Run Text="  " /><Run Text="{Binding Sarcasm}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Sarcasm}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Chaleur}" /><Run Text="  " /><Run Text="{Binding Warmth}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Warmth}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Calme}" /><Run Text="  " /><Run Text="{Binding Calmness}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Calmness}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="{DynamicResource Settings.Verbosite}" /><Run Text="  " /><Run Text="{Binding Verbosity}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Verbosity}" Minimum="0" Maximum="100" TickFrequency="1" />
                    <TextBlock Text="{Binding VerbosityEffect}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                  </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.CADONNE}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Preview}" FontStyle="Italic" LineHeight="22"
                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Settings.TroisRepliquesTireesVrai}" />
                  </StackPanel>
                </ContentControl>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding SaveCommand}" Content="{DynamicResource Settings.Enregistrer}" Padding="20,8" FontWeight="SemiBold" />
            <Button Command="{Binding RevertCommand}" Content="{DynamicResource Settings.AnnulerModifications}" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource Warn}" Text="{DynamicResource Settings.ModificationsNonEnregistrees}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================== Macros ============================== -->
      <TabItem Header="{DynamicResource Macros.Macros}" DataContext="{Binding MacroEditor}">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- ============================== liste ============================== -->
          <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Macros}" SelectedItem="{Binding Selected}"
                     Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                     Foreground="{StaticResource Text}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="10,7" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                      <Run Text="{Binding Origin, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Command="{Binding NewCommand}" Content="{DynamicResource Macros.Nouvelle}" />
              <Button Command="{Binding DuplicateCommand}" Content="{DynamicResource Keys.Dupliquer}" Margin="6,0,0,0" />
              <Button Command="{Binding DeleteCommand}" Content="{DynamicResource Keys.Supprimer}" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>

          <!-- ============================= éditeur ============================= -->
          <Grid Grid.Column="1" IsEnabled="{Binding CanEdit}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="{DynamicResource Macros.NOM}" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="{DynamicResource Macros.QuOptimusPrononceQuand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="{DynamicResource Macros.FORMULATIONSLIGNE}" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding Phrases, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True" MinHeight="72" VerticalScrollBarVisibility="Auto"
                           TextWrapping="NoWrap" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="{DynamicResource Macros.EcrivezAccentueesMoteurDeduit}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource Macros.TEMPORISATION}" Style="{StaticResource Label}" />
                  <TextBox Text="{Binding CooldownMs, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Hint}"
                             Text="{DynamicResource Macros.MillisecondesEmpecheRelancerPendant}" />
                </StackPanel>
              </Grid>
            </ContentControl>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
              </Grid.ColumnDefinitions>

              <ListBox Grid.Column="0" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                       Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                       Foreground="{StaticResource Text}" FontFamily="Consolas">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,5" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas" TextWrapping="Wrap"
                               Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <!-- Les valeurs par defaut sont indispensables : sans elles, la fin du
                               declencheur rend UnsetValue, que Foreground refuse - et l'exception
                               remonte jusqu'a la fenetre. -->
                          <Setter Property="Foreground" Value="{StaticResource Text}" />
                          <Setter Property="FontStyle" Value="Normal" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarker}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                              <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ContentControl Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"
                      DataContext="{Binding SelectedStep}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Macros.ETAPECHOISIE}" Style="{StaticResource Label}" />

                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                             Text="{DynamicResource Macros.ChoisissezEtapeSequenceModifier}">
                    <TextBlock.Visibility>
                      <Binding Path="." Converter="{StaticResource NullToVisible}"
                               FallbackValue="Visible" TargetNullValue="Visible" />
                    </TextBlock.Visibility>
                  </TextBlock>

                  <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="{DynamicResource Macros.Commande}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <ComboBox ItemsSource="{Binding DataContext.Callable,
                                            RelativeSource={RelativeSource AncestorType=TabItem}}"
                              SelectedItem="{Binding CommandId}" />

                    <TextBlock Text="{DynamicResource Macros.Sens}" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                    <ComboBox SelectedIndex="{Binding Polarity, Converter={StaticResource PolarityToIndex}}">
                      <ComboBoxItem Content="{DynamicResource Macros.Basculer}" />
                      <ComboBoxItem Content="{DynamicResource Macros.Allumer}" />
                      <ComboBoxItem Content="{DynamicResource Macros.Eteindre}" />
                    </ComboBox>

                    <CheckBox IsChecked="{Binding RequireDirected}"
                              Content="{DynamicResource Macros.ExigerSensGaranti}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Macros.RenonceLEtapePlutot}" />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="{DynamicResource Macros.Interroge}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <ComboBox SelectedIndex="{Binding Subject, Converter={StaticResource SubjectToIndex}}">
                      <ComboBoxItem Content="{DynamicResource Macros.CommandeToutesTouches}" />
                      <ComboBoxItem Content="{DynamicResource Macros.SensGarantiJeu}" />
                      <ComboBoxItem Content="{DynamicResource Macros.OptimusSimule}" />
                      <ComboBoxItem Content="{DynamicResource Macros.ModeVol}" />
                      <ComboBoxItem Content="{DynamicResource Macros.LEtatSupposeD}" />
                    </ComboBox>
                    <TextBlock Text="{Binding SubjectCaveat}" Style="{StaticResource Hint}" />

                    <StackPanel Visibility="{Binding ConditionNeedsCommand, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="{DynamicResource Macros.CommandeVisee}" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox ItemsSource="{Binding DataContext.Callable,
                                              RelativeSource={RelativeSource AncestorType=TabItem}}"
                                SelectedItem="{Binding ConditionCommandId}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ConditionNeedsPolarity, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="{DynamicResource Macros.Sens}" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox SelectedIndex="{Binding ConditionPolarity, Converter={StaticResource PolarityToIndex}}">
                        <ComboBoxItem Content="{DynamicResource Macros.Basculer}" IsEnabled="False" />
                        <ComboBoxItem Content="{DynamicResource Macros.Allumer}" />
                        <ComboBoxItem Content="{DynamicResource Macros.Eteindre}" />
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ConditionNeedsValue, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                      <TextBlock Text="{DynamicResource Macros.ValeurAttendue}" Style="{StaticResource Hint}" Margin="0,10,0,2" />
                      <ComboBox ItemsSource="{Binding ConditionValues}" SelectedItem="{Binding ConditionValue}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding ConditionNegated}" Content="{DynamicResource Macros.InverserCondition}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Macros.EtapesSuivantesIndenteesForment}" />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsLoop, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="{DynamicResource Macros.NombreTours}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Times, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Macros.CompteFixeEntre1}" />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsWait, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="{DynamicResource Macros.AttenteMs}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding WaitMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Macros.JeuRepondDeuxTouches}" />
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsSay, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <TextBlock Text="{DynamicResource Macros.CleReplique}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding ResponseKey, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{DynamicResource Macros.EntreeResponsesFrJson}" />
                  </StackPanel>
                </StackPanel>
              </ContentControl>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
              <Button Command="{Binding AddCommandStepCommand}" Content="{DynamicResource Macros.Commande2}" />
              <Button Command="{Binding AddWaitStepCommand}" Content="{DynamicResource Macros.Attente}" Margin="6,0,0,0" />
              <Button Command="{Binding AddSayStepCommand}" Content="{DynamicResource Macros.Parole}" Margin="6,0,0,0" />
              <Button Command="{Binding AddBranchStepCommand}" Content="{DynamicResource Macros.Si}" Margin="6,0,0,0" />
              <Button Command="{Binding AddLoopStepCommand}" Content="{DynamicResource Macros.Repeter}" Margin="6,0,0,0" />
              <Border Width="1" Background="{StaticResource Line}" Margin="12,2" />
              <Button Command="{Binding MoveUpCommand}" Content="{DynamicResource Macros.Monter}" />
              <Button Command="{Binding MoveDownCommand}" Content="{DynamicResource Macros.Descendre}" Margin="6,0,0,0" />
              <Button Command="{Binding RemoveStepCommand}" Content="{DynamicResource Keys.Retirer}" Margin="6,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Content="{DynamicResource Settings.Enregistrer}" Padding="20,8"
                        FontWeight="SemiBold" />
                <Button Command="{Binding RevertCommand}" Content="{DynamicResource Macros.Annuler}" Margin="6,0,0,0" />
                <Button Command="{Binding TestCommand}" Content="{DynamicResource Macros.EssayerSimulation}"
                        Margin="6,0,0,0" />
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding Verdict}" Margin="16,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource Warn}" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- =========================== Compréhension =========================== -->
      <TabItem Header="{DynamicResource Understanding.Comprehension}" DataContext="{Binding Understanding}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ContentControl Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Hint}"
                         Text="{DynamicResource Understanding.GrammaireFermeeOptimusPeut}" />
            </StackPanel>
          </ContentControl>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
              </Grid.RowDefinitions>

              <ListView Grid.Row="0" ItemsSource="{Binding Hesitations}"
                        SelectedItem="{Binding Selected}"
                        ItemContainerStyle="{StaticResource GridRow}">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="{DynamicResource Understanding.ENTENDU}" Width="190" DisplayMemberBinding="{Binding Heard}" />
                    <GridViewColumn Header="{DynamicResource Understanding.QUILFAIT}" Width="160" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="{DynamicResource Understanding.COMMANDEENVISAGEE}" Width="170" DisplayMemberBinding="{Binding CommandName}" />
                    <GridViewColumn Header="{DynamicResource Understanding.FREQUENCE}" Width="230" DisplayMemberBinding="{Binding Detail}" />
                  </GridView>
                </ListView.View>
              </ListView>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Command="{Binding IgnoreCommand}" Content="{DynamicResource Understanding.IgnorerCetteLigne}" />
                <Button Command="{Binding ClearCommand}" Content="{DynamicResource Understanding.ViderListe}" Margin="6,0,0,0" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="{DynamicResource Understanding.VOSFORMULATIONS}" Style="{StaticResource Label}"
                         Margin="0,16,0,4" />

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" ItemsSource="{Binding Aliases}"
                          SelectedItem="{Binding SelectedAlias}"
                          ItemContainerStyle="{StaticResource GridRow}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="{DynamicResource Understanding.FORMULATION}" Width="260" DisplayMemberBinding="{Binding Phrase}" />
                      <GridViewColumn Header="{DynamicResource Commands.COMMANDE}" Width="230" DisplayMemberBinding="{Binding CommandName}" />
                      <GridViewColumn Header="{DynamicResource Understanding.SENS}" Width="120" DisplayMemberBinding="{Binding Sense}" />
                    </GridView>
                  </ListView.View>
                </ListView>

                <Button Grid.Column="1" Command="{Binding RemoveAliasCommand}" Content="{DynamicResource Keys.Retirer}"
                        Margin="8,0,0,0" VerticalAlignment="Top" />
              </Grid>
            </Grid>

            <ContentControl Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"
                    VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="{DynamicResource Understanding.APPRENDREFORMULATION}" Style="{StaticResource Label}" />

                <TextBlock Text="{DynamicResource Understanding.VousDitesReellement}" Style="{StaticResource Hint}"
                           Margin="0,8,0,2" />
                <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{DynamicResource Understanding.EcrivezAccentueeMoteurDeduit}" />

                <TextBlock Text="{DynamicResource Understanding.CommandeDeclencher}" Style="{StaticResource Hint}"
                           Margin="0,12,0,2" />
                <ComboBox ItemsSource="{Binding Commands}" SelectedItem="{Binding TargetCommand}" />

                <TextBlock Text="{DynamicResource Macros.Sens}" Style="{StaticResource Hint}" Margin="0,12,0,2" />
                <ComboBox SelectedIndex="{Binding Polarity, Converter={StaticResource PolarityToIndex}}">
                  <ComboBoxItem Content="{DynamicResource Understanding.AucunBascule}" />
                  <ComboBoxItem Content="{DynamicResource Understanding.Activation}" />
                  <ComboBoxItem Content="{DynamicResource Understanding.Extinction}" />
                </ComboBox>

                <Button Command="{Binding AddCommand}" Content="{DynamicResource Understanding.Apprendre}" Margin="0,16,0,0"
                        Padding="20,8" FontWeight="SemiBold" HorizontalAlignment="Left" />

                <TextBlock Text="{Binding Verdict}" Style="{StaticResource Hint}"
                           Foreground="{StaticResource Warn}" Margin="0,10,0,0" />

                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                           Text="{DynamicResource Understanding.FormulationEnregistreeHorsCatalogue}" />
              </StackPanel>
            </ContentControl>
          </Grid>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
