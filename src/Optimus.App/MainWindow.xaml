<Window x:Class="Optimus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bind="clr-namespace:Optimus.Core.Bindings;assembly=Optimus.Core"
        Title="Optimus" Height="760" Width="1180" MinHeight="560" MinWidth="960"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================== Bandeau d'état ============================== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="OPTIMUS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
            <Run Text="{Binding CopilotName, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding VoiceName, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <StackPanel Margin="18,0">
            <TextBlock Text="STAR CITIZEN" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding GameLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameReady}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Ok}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="MODE" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding ModeLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReal}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel Margin="18,0">
            <TextBlock Text="VOL" Style="{StaticResource Label}" />
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="navigation" />
                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CombatActive}" Value="True">
                      <Setter Property="Text" Value="COMBAT" />
                      <Setter Property="Foreground" Value="{StaticResource Warn}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <!-- L'arret d'urgence reste visible en permanence (§37) : le chercher dans un
             onglet quand une touche part en boucle serait absurde. -->
        <Button Grid.Column="2" Command="{Binding ToggleKillSwitchCommand}"
                Content="{Binding KillSwitchLabel}" FontWeight="Bold" Padding="18,10">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Foreground" Value="{StaticResource Danger}" />
              <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding KillSwitch}" Value="True">
                  <Setter Property="Background" Value="{StaticResource Danger}" />
                  <Setter Property="Foreground" Value="#12151A" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

      <!-- ========================= Poste de pilotage ========================= -->
      <TabItem Header="Poste de pilotage">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <Button Command="{Binding ToggleListeningCommand}" Content="{Binding ListeningLabel}"
                    Padding="18,12" FontSize="14" FontWeight="SemiBold" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11">
              <Run Text="Dites «&#160;" /><Run Text="{Binding WakeWord, Mode=OneWay}" /><Run Text=",&#160;…&#160;» pour être entendu." />
            </TextBlock>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="ENVOI DE TOUCHES" Style="{StaticResource Label}" />
            <Button Command="{Binding ToggleSimulationCommand}" Content="{Binding ModeLabel}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="En simulation, rien n'est envoyé au jeu : la séquence est tracée telle qu'elle aurait été jouée." />

            <Border Height="1" Background="{StaticResource Line}" Margin="0,16" />

            <TextBlock Text="ESSAYER UN ÉNONCÉ" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Utterance, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnUtteranceKeyDown" />
            <Button Command="{Binding SendCommand}" Content="Envoyer" Margin="0,8,0,0" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Text="Passe par la même chaîne que la voix, sans le micro. Utile pour vérifier une formulation." />
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="14,10">
                <TextBlock Text="JOURNAL" Style="{StaticResource Label}" VerticalAlignment="Center" />
                <Button Command="{Binding ClearJournalCommand}" Content="Effacer"
                        HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
              </Grid>

              <ListView Grid.Row="1" x:Name="JournalList" ItemsSource="{Binding Journal}"
                        BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                 FontSize="11" Foreground="{StaticResource TextMuted}"
                                 VerticalAlignment="Top" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource JournalTitle}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============================= Commandes ============================= -->
      <TabItem Header="Commandes">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding CatalogSummary}" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />
            <Button Command="{Binding TestCommandCommand}" Content="Tester la commande choisie"
                    HorizontalAlignment="Right" />
          </Grid>

          <ListView Grid.Row="1" ItemsSource="{Binding Commands}"
                    SelectedItem="{Binding SelectedCommand}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="CATÉGORIE" Width="110" DisplayMemberBinding="{Binding Category}" />
                <GridViewColumn Header="COMMANDE" Width="210" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="TOUCHE" Width="190">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Binding}" FontFamily="Consolas">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsBinding}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="FORMULATIONS" Width="520" DisplayMemberBinding="{Binding Phrases}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <!-- ============================== Touches ============================== -->
      <TabItem Header="Touches">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding BindingFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Cherchez par libellé ou par ce que vous dites : « lumieres », « portes »…" />
            <TextBlock Grid.Column="1" Text="{Binding BindingSummary}" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          </Grid>

          <ListView Grid.Row="1" ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedSlot}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="ÉTAT" Width="120">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="à configurer" />
                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBound}" Value="True">
                                <Setter Property="Text" Value="liée" />
                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsBound}" Value="False" />
                                  <Condition Binding="{Binding Need}"
                                             Value="{x:Static bind:ActionNeed.Directed}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="facultative" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="COMMANDE" Width="210" DisplayMemberBinding="{Binding CommandName}" />
                <GridViewColumn Header="TOUCHE" Width="180">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Input}" FontFamily="Consolas" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="ACTION DU JEU" Width="380" DisplayMemberBinding="{Binding ActionId}" />
                <GridViewColumn Header="ORIGINE" Width="110" DisplayMemberBinding="{Binding Origin}" />
              </GridView>
            </ListView.View>
          </ListView>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding AssignCommand}" Content="Assigner une touche" />
            <Button Command="{Binding UnassignCommand}" Content="Retirer" Margin="8,0,0,0" />
            <Border Width="1" Background="{StaticResource Line}" Margin="14,2" />
            <Button Command="{Binding ImportLayoutCommand}" Content="Importer depuis le jeu" />
            <Button Command="{Binding ExportLayoutCommand}" Content="Exporter vers le jeu" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="Assigner ici ne suffit pas : le jeu n'obéit qu'à ses propres bindings. Exportez, puis « pp_RebindKeys optimus »." />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============================= Réglages ============================= -->
      <TabItem Header="Réglages" DataContext="{Binding Settings}">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="ÉCOUTE" Style="{StaticResource Label}" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding AlwaysOn}"
                                 Content="Écoute permanente, déclenchée par le mot d'éveil" />
                    <RadioButton GroupName="Mode" IsChecked="{Binding PushToTalk}"
                                 Content="Push-to-talk : une touche maintenue" />
                    <TextBlock Text="{Binding ModeExplanation}" Style="{StaticResource Hint}" />

                    <Grid Margin="0,14,0,0" IsEnabled="{Binding PushToTalk}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding PushToTalkKey}" IsReadOnly="True"
                               FontFamily="Consolas" VerticalContentAlignment="Center" />
                      <Button Grid.Column="1" Margin="8,0,0,0" Content="Presser une touche"
                              Command="{Binding CaptureKeyCommand}" />
                    </Grid>
                    <CheckBox IsChecked="{Binding RequireWakeWordInPushToTalk}"
                              IsEnabled="{Binding PushToTalk}"
                              Content="Exiger quand même le mot d'éveil" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="MOT D'ÉVEIL" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding WakeWord, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Le changer reconstruit toute la grammaire. Choisissez un mot que vous ne prononcez pas par hasard en vol." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="SEUILS DE RECONNAISSANCE" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Plancher de bruit :" />
                      <Run Text="{Binding NoiseFloor, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding NoiseFloor}" Minimum="0" Maximum="0.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Exécution à partir de :" />
                      <Run Text="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding ConfidenceThreshold}" Minimum="0.3" Maximum="0.95" TickFrequency="0.01" />

                    <TextBlock Text="{Binding ThresholdExplanation}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="VOIX" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding VoiceId}" />

                    <TextBlock Margin="0,10,0,0" FontSize="12">
                      <Run Text="Débit :" />
                      <Run Text="{Binding Rate, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Rate}" Minimum="0.5" Maximum="1.6" TickFrequency="0.01" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Volume :" />
                      <Run Text="{Binding Volume, StringFormat={}{0:F2}}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Volume}" Minimum="0.1" Maximum="1.0" TickFrequency="0.01" />

                    <Button Content="Écouter un essai" Command="{Binding TestVoiceCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="L'essai emploie les réglages affichés, pas ceux enregistrés : vous entendez avant de valider." />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="CARACTÈRE" Style="{StaticResource Label}" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Formalité" /><Run Text="  " /><Run Text="{Binding Formality}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Formality}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Humour" /><Run Text="  " /><Run Text="{Binding Humor}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Humor}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Ironie" /><Run Text="  " /><Run Text="{Binding Sarcasm}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Sarcasm}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Chaleur" /><Run Text="  " /><Run Text="{Binding Warmth}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Warmth}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Calme" /><Run Text="  " /><Run Text="{Binding Calmness}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Calmness}" Minimum="0" Maximum="100" TickFrequency="1" />

                    <TextBlock Margin="0,6,0,0" FontSize="12">
                      <Run Text="Verbosité" /><Run Text="  " /><Run Text="{Binding Verbosity}" FontFamily="Consolas" />
                    </TextBlock>
                    <Slider Value="{Binding Verbosity}" Minimum="0" Maximum="100" TickFrequency="1" />
                    <TextBlock Text="{Binding VerbosityEffect}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="CE QUE ÇA DONNE" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Preview}" FontStyle="Italic" LineHeight="22"
                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Trois répliques tirées du vrai catalogue, composées avec les curseurs ci-contre. Une variante ironique n'apparaît qu'au-dessus d'un certain seuil." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Command="{Binding SaveCommand}" Content="Enregistrer" Padding="20,8" FontWeight="SemiBold" />
            <Button Command="{Binding RevertCommand}" Content="Annuler les modifications" Margin="8,0,0,0" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource Warn}" Text="Modifications non enregistrées">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </TabItem>

    </TabControl>
  </Grid>
</Window>
