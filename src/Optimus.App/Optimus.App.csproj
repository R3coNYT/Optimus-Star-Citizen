<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      L'application de bureau : une seule fenêtre, pas de service, pas de microservice (§70).
      Elle ne contient aucune logique de commande - tout vient d'Optimus.Infrastructure, de
      sorte que le banc d'essai en ligne de commande et cette fenêtre partagent exactement le
      même moteur et ne peuvent pas diverger.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      L'icone est embarquee dans l'executable, et non chargee au demarrage : c'est elle
      que montrent la barre des taches, l'explorateur et le raccourci du Bureau, avant
      meme qu'Optimus ait demarre. La fenetre WPF la reprend d'elle-meme, faute de
      propriete Icon explicite - une seule source, donc, pour tous les endroits.

      Le .ico se refabrique depuis le logo par tools\make-icon.ps1.
    -->
    <ApplicationIcon>..\..\images\Optimus.ico</ApplicationIcon>

    <!--
      L'ICU doit rester active : sans elle, string.Normalize cesse de décomposer les accents
      et « lumières » devient « lumi res » - ce qui avait fait résoudre la mauvaise commande.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimus.Infrastructure\Optimus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
