<Application x:Class="Optimus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Optimus.App.ViewModels"
             xmlns:mvvm="clr-namespace:Optimus.App.Mvvm">
  <Application.Resources>

    <mvvm:BoolToVisibleConverter x:Key="BoolToVisible" />
    <mvvm:PolarityToIndexConverter x:Key="PolarityToIndex" />
    <mvvm:NullToVisibleConverter x:Key="NullToVisible" />
    <mvvm:DepthToMarginConverter x:Key="DepthToMargin" />
    <mvvm:SubjectToIndexConverter x:Key="SubjectToIndex" />

    <!--
      ============================================================================
      Le langage visuel : celui du mobiGlas de Star Citizen.
      ============================================================================

      Optimus se regarde entre deux manoeuvres, l'oeil encore dans le cockpit.
      Prendre la langue graphique du jeu n'est donc pas une coquetterie : c'est
      eviter au pilote de changer de registre visuel toutes les trente secondes.

      Ce que cette langue tient en quatre regles :

        - Le fond est presque noir, teinte de bleu. Rien n'y est peint en aplat
          clair ; les panneaux sont des VERRES sombres, pas des cartons.
        - Les traits sont des cheveux d'un pixel, cyan froid. Ce qui delimite ne
          crie pas ; ce qui compte s'allume.
        - Les coins portent des equerres, jamais d'arrondis. Un angle vif se lit
          comme un instrument, un arrondi comme une application de bureau.
        - La couleur porte un sens et un seul : cyan pour ce qui est actif, vert
          pour ce qui est nominal, ambre pour ce qui demande attention, rouge pour
          ce qui bloque.

      La typographie est Bahnschrift - le DIN livre avec Windows 10, donc toujours
      present puisque l'installateur exige 10.0.19041 - parce qu'elle est etroite,
      technique, et lisible en capitales sans etre bavarde. Les nombres passent en
      Consolas, ou les chiffres ont tous la meme largeur : une valeur qui change ne
      fait plus danser la ligne.
    -->

    <!-- ============================ Les couleurs ============================ -->

    <Color x:Key="AccentColor">#48C8E8</Color>
    <Color x:Key="BgColor">#05090E</Color>

    <SolidColorBrush x:Key="Bg"        Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel"     Color="#CC0A141C" />
    <SolidColorBrush x:Key="PanelHigh" Color="#1A2B38" />
    <SolidColorBrush x:Key="Line"      Color="#2B5A73" />
    <SolidColorBrush x:Key="LineFaint" Color="#1B3A4B" />
    <SolidColorBrush x:Key="Text"      Color="#CFE6F2" />
    <SolidColorBrush x:Key="TextMuted" Color="#6C8B9C" />
    <SolidColorBrush x:Key="Accent"    Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Ok"        Color="#3FD98A" />
    <SolidColorBrush x:Key="Warn"      Color="#E8B54A" />
    <SolidColorBrush x:Key="Danger"    Color="#E8646E" />
    <SolidColorBrush x:Key="Select"    Color="#123044" />

    <FontFamily x:Key="Face">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Consolas</FontFamily>

    <!--
      L'echo. Dans le mobiGlas, chaque intitule porte son double, decale et presque
      eteint - comme une remanence de dalle. Une ombre portee sans flou le rend
      exactement, sans dupliquer le texte ni toucher aux vues.
    -->
    <DropShadowEffect x:Key="Echo" BlurRadius="0" ShadowDepth="2" Direction="-70"
                      Color="{StaticResource AccentColor}" Opacity="0.30" />

    <!-- La lueur de ce qui est actif. Discrete : un halo, pas un neon. -->
    <DropShadowEffect x:Key="Glow" BlurRadius="10" ShadowDepth="0"
                      Color="{StaticResource AccentColor}" Opacity="0.55" />

    <!-- ============================== Le texte ============================== -->

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
      Intitule de section. Cyan, petit, avec son echo : c'est la signature de
      l'interface du jeu, et c'est ce qui structure la lecture d'un panneau.
    -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.92" />
      <Setter Property="Effect" Value="{StaticResource Echo}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Une valeur qui change ne doit pas faire danser la ligne. -->
    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================= Le panneau ============================= -->

    <!--
      Le cadre du mobiGlas : un verre sombre, un cheveu cyan, et quatre equerres.

      C'est un ContentControl et non un Border, parce qu'un Border ne sait pas
      superposer les equerres a son propre trait. Le contenu, lui, s'ecrit dedans
      exactement comme avant - d'ou les deux alignements « Stretch », sans lesquels
      un ContentControl reduirait son contenu la ou un Border l'etirait.

      Les equerres sont des chemins de taille fixe, ancres aux angles : elles ne
      s'etirent donc jamais, quelle que soit la taille du panneau.
    -->
    <Style x:Key="Card" TargetType="ContentControl">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Border Background="{StaticResource Panel}"
                      BorderBrush="{StaticResource LineFaint}" BorderThickness="1" />

              <Path Data="M0,14 L0,0 L14,0" Stroke="{StaticResource Line}" StrokeThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-0.5" />
              <Path Data="M0,0 L14,0 L14,14" Stroke="{StaticResource Line}" StrokeThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-0.5" />
              <Path Data="M0,0 L0,14 L14,14" Stroke="{StaticResource Line}" StrokeThickness="1"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-0.5" />
              <Path Data="M0,14 L14,14 L14,0" Stroke="{StaticResource Line}" StrokeThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-0.5" />

              <!-- Le trait vif du haut : ce qui distingue un instrument d'un cadre. -->
              <Rectangle Width="34" Height="1" Fill="{StaticResource Accent}" Opacity="0.75"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,-0.5,0,0" />

              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- =========================== Les commandes =========================== -->

    <Style TargetType="Button">
      <Setter Property="Background" Value="#33123044" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Shell">
              <Border x:Name="Face" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" />

              <!-- Deux equerres suffisent : quatre alourdiraient un bouton. -->
              <Path x:Name="TopLeft" Data="M0,9 L0,0 L9,0" StrokeThickness="1"
                    Stroke="{StaticResource Accent}" Opacity="0.55"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-0.5" />
              <Path x:Name="BottomRight" Data="M0,9 L9,9 L9,0" StrokeThickness="1"
                    Stroke="{StaticResource Accent}" Opacity="0.55"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-0.5" />

              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Face" Property="Background" Value="#4D1B4A66" />
                <Setter TargetName="TopLeft" Property="Opacity" Value="1" />
                <Setter TargetName="BottomRight" Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="#EAF7FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#66246B8C" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.35" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#99060F16" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineFaint}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="FontSize" Value="13" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ListView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource LineFaint}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!--
      En-tete de colonne. Le gabarit par defaut garde un fond clair au survol et au clic - une
      bande eclatante qui restait allumee apres coup. On le reprend, sobre.
    -->
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Border x:Name="Shell" Background="#4D0E2233"
                    BorderBrush="{StaticResource LineFaint}" BorderThickness="0,0,1,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Onglet. Dans le mobiGlas, l'onglet actif est tenu par une equerre a gauche et
      un trait vif dessous ; les autres restent des mots eteints.
    -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,0,6,0">
              <Border x:Name="Shell" Padding="20,10" Background="Transparent"
                      BorderThickness="0,0,0,2" BorderBrush="Transparent">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </Border>
              <Path x:Name="Bracket" Data="M6,0 L0,0 L0,26 L6,26" StrokeThickness="1"
                    Stroke="{StaticResource Accent}" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Shell" Property="Background" Value="#26123044" />
                <Setter TargetName="Bracket" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="#EAF7FF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Le ton d'une ligne de journal : discret pour le bruit, ambre pour ce qui demande
         attention, rouge pour ce qui bloque, cyan pour ce qu'Optimus dit. -->
    <Style x:Key="JournalTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:ActivityLevel.Muted}">
          <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:ActivityLevel.Warning}">
          <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:ActivityLevel.Danger}">
          <Setter Property="Foreground" Value="{StaticResource Danger}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:ActivityLevel.Speech}">
          <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--
      Curseur. La piste devient une glissiere d'instrument : un cheveu, la part
      parcourue en cyan, et une poignee losange - l'angle vif, encore, plutot que
      la pastille ronde des applications de bureau.
    -->
    <Style TargetType="Slider">
      <Setter Property="Height" Value="22" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="1" VerticalAlignment="Center"
                      Background="{StaticResource Line}" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" VerticalAlignment="Center"
                                Background="{StaticResource Accent}" Opacity="0.8" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent" Width="16" Height="18">
                          <Path x:Name="Grip" Data="M7,0 L14,7 L7,14 L0,7 Z"
                                Fill="{StaticResource Accent}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Effect" Value="{StaticResource Glow}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Selecteur.
      Le gabarit par defaut habille sa liste deroulante avec les couleurs systeme, prevues pour
      un fond clair : le texte y etait illisible, ferme comme ouvert. On reprend donc le
      gabarit entier - bouton, contenu et fenetre surgissante - pour qu'il suive le theme.
    -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Shell" Background="Transparent" BorderThickness="2,0,0,0"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource PanelHigh}" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Select}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Border x:Name="Face" Background="#99060F16"
                              BorderBrush="{StaticResource LineFaint}" BorderThickness="1" />
                      <Path x:Name="Corner" Data="M0,9 L9,9 L9,0" StrokeThickness="1"
                            Stroke="{StaticResource Accent}" Opacity="0.5"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-0.5" />
                      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{StaticResource Accent}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="Corner" Property="Opacity" Value="1" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="Selection" IsHitTestVisible="False"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                <Border Background="#F20A141C" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" Margin="0,2,0,0"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Case a cocher et bouton radio. Le carre garde ses angles vifs et s'allume ;
      le radio devient un losange, la forme que le jeu emploie pour un objectif.
    -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="14" Height="14" VerticalAlignment="Center"
                      Background="#99060F16" BorderBrush="{StaticResource Line}"
                      BorderThickness="1">
                <Rectangle x:Name="Fill" Margin="3" Visibility="Collapsed"
                           Fill="{StaticResource Accent}" />
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="Effect" Value="{StaticResource Glow}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="15" Height="15" VerticalAlignment="Center">
                <Path x:Name="Ring" Data="M7,0 L14,7 L7,14 L0,7 Z" StrokeThickness="1"
                      Stroke="{StaticResource Line}" Fill="#99060F16" />
                <Path x:Name="Dot" Data="M7,3.5 L10.5,7 L7,10.5 L3.5,7 Z"
                      Fill="{StaticResource Accent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                <Setter TargetName="Dot" Property="Effect" Value="{StaticResource Glow}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Barre de defilement. Celle du systeme est claire et large : deux bandes
      eclatantes de chaque cote d'un panneau sombre. Reduite a un cheveu cyan.
    -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Rectangle Width="1" Fill="{StaticResource LineFaint}"
                         HorizontalAlignment="Center" />
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                Opacity="0" Background="Transparent" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                Opacity="0" Background="Transparent" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Rectangle x:Name="Bar" Width="3" Fill="{StaticResource Accent}"
                                   Opacity="0.6" HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Infobulle : fond clair par defaut, seule chose eblouissante de l'interface. -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#F20A141C" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
      Ligne d'une liste a colonnes.
      Le gabarit par defaut peint la selection avec les couleurs systeme, prevues pour un fond
      clair : sur ce fond sombre, le texte devenait illisible des qu'on cliquait une ligne. On
      reprend donc le gabarit, en conservant le GridViewRowPresenter sans lequel les colonnes ne
      s'afficheraient plus du tout.
    -->
    <Style x:Key="GridRow" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Shell" Background="Transparent" BorderThickness="0,0,0,1"
                    BorderBrush="#141B3A4B" Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                                    Columns="{TemplateBinding GridView.ColumnCollection}"
                                    VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource PanelHigh}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Select}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#EAF7FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Ligne d'une liste SANS colonnes, journal compris. Le gabarit a colonnes ne conviendrait
      pas ici : son GridViewRowPresenter n'afficherait rien faute de colonnes a presenter.
    -->
    <Style x:Key="PlainRow" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Shell" Background="Transparent" BorderThickness="2,0,0,0"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource PanelHigh}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Select}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#EAF7FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Meme raison pour les listes simples : l'entree selectionnee doit rester lisible.
    -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Face}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Shell" Background="Transparent" BorderThickness="2,0,0,0"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource PanelHigh}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Select}" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#EAF7FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
