<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Cible Windows explicite : cette couche pilote SendInput, les hooks bas niveau et les
      processus. Le déclarer permet à l'analyseur de compatibilité de valider ces appels au
      lieu de les signaler, et documente au passage la seule plateforme réellement visée.
      Le cœur (Optimus.Core), lui, reste neutre et testable partout.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <!--
      Exigé par le générateur de sources de LibraryImport, qui produit des marshalers
      utilisant des pointeurs. C'est le prix du P/Invoke moderne - et il est cantonné à
      cette couche : Optimus.Core n'en a pas besoin et ne l'active pas.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimus.Core\Optimus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
